{
    "name": "gateway/high-throughput-api-gateway",
    "type": "project",
    "description": "High-Throughput API Gateway built with PHP 8.3, Laravel 11, Laravel Octane (Swoole), Redis, and Kubernetes.",
    "keywords": [
        "laravel",
        "framework",
        "octane",
        "swoole",
        "api-gateway",
        "redis",
        "rate-limiter",
        "circuit-breaker"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^6.10.1",
        "guzzlehttp/guzzle": "^7.8.1",
        "laravel/framework": "^11.15.0",
        "laravel/octane": "^2.5.0",
        "laravel/sanctum": "^4.0.2",
        "laravel/tinker": "^2.9.0",
        "predis/predis": "^2.2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23.1",
        "larastan/larastan": "^2.9.0",
        "laravel/pint": "^1.15.0",
        "laravel/sail": "^1.29.0",
        "mockery/mockery": "^1.6.11",
        "nunomaduro/collision": "^8.1.1",
        "phpunit/phpunit": "^11.1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
