APP_NAME="High-Throughput API Gateway"
APP_ENV=local
APP_KEY=base64:c3VwZXJzZWNyZXRwYXNzd29yZGtleWZvcmFwaWdhdGV3YXk=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

OCTANE_SERVER=swoole
OCTANE_HTTPS=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

GATEWAY_AUTH_SECRET=super-secret-jwt-signing-key-for-api-gateway-auth-2025
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30

SERVICE_USERS_URL=http://127.0.0.1:8001
SERVICE_ORDERS_URL=http://127.0.0.1:8002
SERVICE_PRODUCTS_URL=http://127.0.0.1:8003
